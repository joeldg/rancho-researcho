RANCHO_ENV=development
RANCHO_PUBLIC_BASE_URL=https://research.example.com

# Configure the trusted internal SearXNG provider before /v1/search can return results.
RANCHO_SEARCH_PROVIDER=searxng
RANCHO_SEARCH_BASE_URL=http://searxng:8080
RANCHO_SEARCH_API_KEY=
RANCHO_MAX_RESULTS=10

# Optionally fan the query across several providers (comma list of
# searxng, duckduckgo, bing). When unset, RANCHO_SEARCH_PROVIDER above is used.
RANCHO_SEARCH_PROVIDERS=
# Bing Web Search key; only needed when 'bing' is in RANCHO_SEARCH_PROVIDERS.
RANCHO_BING_API_KEY=

# Trusted internal local LLM control-plane (OpenAI-compatible Ollama/vLLM).
# Leave RANCHO_LLM_PROVIDER empty to keep the LLM client disabled.
RANCHO_LLM_PROVIDER=
RANCHO_LLM_BASE_URL=http://ollama:11434
RANCHO_LLM_MODEL=llama3.1:8b
RANCHO_LLM_COMPLEX_MODEL=
RANCHO_LLM_API_KEY=

# --- Docker Compose stack secrets (see docker-compose.yml) ---
# Placeholders only. Never commit real values; .env is git-ignored.
# Generate a SearXNG secret with: openssl rand -hex 32
SEARXNG_SECRET=
# PostgreSQL password; the stack builds RANCHO_DATABASE_URL from it.
POSTGRES_PASSWORD=
# Host port the API (and only the API) is published on.
RANCHO_HOST_PORT=8000

# These values apply when running the API outside Compose (e.g. uv run).
# Inside the Compose stack they are derived from the service names above.
RANCHO_DATABASE_URL=postgresql://rancho:rancho@localhost:5432/rancho
RANCHO_REDIS_URL=redis://localhost:6379/0
